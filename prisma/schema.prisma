generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SurveyResponse {
  id        String   @id @default(cuid())
  name      String
  firstCat  String
  firstSub  String
  secondCat String
  secondSub String
  thirdCat  String
  thirdSub  String
  fourthCat String? @default("")
  fourthSub  String? @default("")
  suggestions String? @default("")
  createdAt DateTime @default(now())

  @@map("survey_responses")
}

model PrizeData {
  id        String   @id @default(cuid())
  key       String
  level     String   // "first" | "second" | "third"
  label     String
  icon      String   @default("star")
  subs      Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, level])
  @@map("prize_data")
}
